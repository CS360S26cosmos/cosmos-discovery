<?xml version="1.0" encoding="utf-8"?>
<!--
    Student shell layout.
    Layer 1 (ConstraintLayout): purple header (top bar + search pill) +
                                content fragment container (rounded top) +
                                bottom nav bar.
    Layer 2 (include): full-screen sidebar overlay, GONE by default.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ── Main screen chrome ────────────────────────────────────────── -->
    <!-- Purple background here is what shows through the card's rounded top corners,
         matching the login page where the root ConstraintLayout is also color_primary. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_primary">

        <!-- Purple header: top bar + search bar pill -->
        <LinearLayout
            android:id="@+id/layoutTopBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/color_primary"
            android:paddingTop="12dp"
            android:paddingBottom="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <include
                android:id="@+id/topBarView"
                layout="@layout/view_top_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <!-- Search bar — tap to open search -->
            <include
                android:id="@+id/searchBarInclude"
                layout="@layout/component_searchbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="32dp" />

            <!-- Search active state: EditText + filter button inside the card,
                 mirroring the Discover/inactive search bar layout so the filter
                 icon lives inside the bar pill instead of floating beside it. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/searchActiveBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/color_card_bg"
                app:cardCornerRadius="28dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="12dp">

                    <EditText
                        android:id="@+id/etSearchInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/inter_variable"
                        android:hint="Search Events"
                        android:inputType="text"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        android:singleLine="true"
                        android:textColor="@color/color_text_secondary"
                        android:textColorHint="@color/color_text_hint"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/filterButtonActive"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/filter"
                        android:padding="8dp"
                        android:src="@drawable/ic_filter_icon"
                        app:tint="@color/color_icon_outline" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!--
            MaterialCardView wraps the fragment container and reliably clips its
            children to the 32dp rounded top corners — same radius as bg_bottom_card
            used on the login/signup screens. clipToOutline on a raw FrameLayout does
            NOT clip child views, which is why the plain drawable approach failed.
            Bottom extends to screen edge so it slides behind the nav bar (drawn on top).
        -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/contentCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:shapeAppearance="@style/ShapeAppearance.ContentCard"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/color_surface"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/layoutTopBar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/studentFragmentContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Bottom nav bar — declared after contentCard so it renders on top -->
        <include
            android:id="@+id/navBarView"
            layout="@layout/component_navbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── Sidebar overlay (GONE until menu icon tapped) ─────────────── -->
    <include
        android:id="@+id/sidebarView"
        layout="@layout/component_sidebar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- ── Filter overlay (GONE until filter button tapped) ──────────── -->
    <include
        android:id="@+id/filterOverlay"
        layout="@layout/component_searchbar_filter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
