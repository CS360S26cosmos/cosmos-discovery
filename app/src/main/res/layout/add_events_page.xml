<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_primary">

        <!-- Top purple section -->
        <View
            android:id="@+id/topSection"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:background="@color/color_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Back arrow -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="20dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_eventdetails_arrowback"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/topSection"
            app:layout_constraintVertical_bias="0.5"
            app:tint="@color/color_surface_white" />

        <!-- Screen title -->
        <TextView
            android:id="@+id/tvAddEventTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_variable"
            android:text="Add New Event"
            android:textColor="@color/color_surface_white"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/topSection"
            app:layout_constraintBottom_toBottomOf="@id/topSection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Pink rounded content background -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/contentCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:shapeAppearance="@style/ShapeAppearance.ContentCard"
            app:cardBackgroundColor="@color/color_surface"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/topSection"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Form -->
        <ScrollView
            android:id="@+id/formScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="ifContentScrolls"
            app:layout_constraintTop_toBottomOf="@id/topSection"
            app:layout_constraintBottom_toTopOf="@id/actionButtonsRow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="50dp"
                android:paddingTop="26dp"
                android:paddingEnd="50dp"
                android:paddingBottom="16dp">

                <!-- Name -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:cardBackgroundColor="@color/color_surface_white"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <EditText
                        android:id="@+id/etEventName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/inter"
                        android:gravity="center_vertical"
                        android:hint="Name"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:singleLine="true"
                        android:textColor="@color/color_icon_outline"
                        android:textColorHint="@color/color_text_tertiary"
                        android:textSize="16sp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Description -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    app:cardBackgroundColor="@color/color_surface_white"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <EditText
                        android:id="@+id/etDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="74dp"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/inter"
                        android:gravity="top|start"
                        android:hint="Description"
                        android:inputType="textMultiLine|textCapSentences"
                        android:paddingStart="16dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="10dp"
                        android:scrollHorizontally="false"
                        android:textColor="@color/color_icon_outline"
                        android:textColorHint="@color/color_text_tertiary"
                        android:textSize="16sp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Category -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    app:cardBackgroundColor="@color/color_surface_white"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etCategory"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/inter"
                            android:gravity="center_vertical"
                            android:hint="Category"
                            android:paddingStart="16dp"
                            android:paddingEnd="8dp"
                            android:singleLine="true"
                            android:textColor="@color/color_icon_outline"
                            android:textColorHint="@color/color_text_tertiary"
                            android:textSize="16sp" />

                        <ImageView
                            android:id="@+id/iconCategory"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="14dp"
                            android:contentDescription="Category dropdown"
                            android:src="@drawable/ic_addevent_dropdown"
                            app:tint="#B29F9F" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Banner Image Upload -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    app:cardBackgroundColor="@color/color_surface_white"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etBannerUpload"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/inter"
                            android:gravity="center_vertical"
                            android:hint="Banner Image Upload"
                            android:paddingStart="16dp"
                            android:paddingEnd="8dp"
                            android:singleLine="true"
                            android:textColor="@color/color_icon_outline"
                            android:textColorHint="@color/color_text_tertiary"
                            android:textSize="16sp" />

                        <ImageView
                            android:id="@+id/iconBannerUpload"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="14dp"
                            android:contentDescription="Banner upload"
                            android:src="@drawable/ic_addevent_upload"
                            app:tint="#B29F9F" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Date of Event -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    app:cardBackgroundColor="@color/color_surface_white"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etDateOfEvent"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/inter"
                            android:gravity="center_vertical"
                            android:hint="Date of Event"
                            android:paddingStart="16dp"
                            android:paddingEnd="8dp"
                            android:singleLine="true"
                            android:textColor="@color/color_icon_outline"
                            android:textColorHint="@color/color_text_tertiary"
                            android:textSize="16sp" />

                        <ImageView
                            android:id="@+id/iconDateOfEvent"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="14dp"
                            android:contentDescription="Date of event"
                            android:src="@drawable/ic_eventdetails_calendar"
                            app:tint="#B29F9F" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Start time -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    app:cardBackgroundColor="@color/color_surface_white"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etStartTime"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/inter"
                            android:gravity="center_vertical"
                            android:hint="Start time"
                            android:paddingStart="16dp"
                            android:paddingEnd="8dp"
                            android:singleLine="true"
                            android:textColor="@color/color_icon_outline"
                            android:textColorHint="@color/color_text_tertiary"
                            android:textSize="16sp" />

                        <ImageView
                            android:id="@+id/iconStartTime"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="14dp"
                            android:contentDescription="Start time"
                            android:src="@drawable/ic_eventdetails_clock"
                            app:tint="#B29F9F" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- End Time -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    app:cardBackgroundColor="@color/color_surface_white"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etEndTime"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/inter"
                            android:gravity="center_vertical"
                            android:hint="End Time"
                            android:paddingStart="16dp"
                            android:paddingEnd="8dp"
                            android:singleLine="true"
                            android:textColor="@color/color_icon_outline"
                            android:textColorHint="@color/color_text_tertiary"
                            android:textSize="16sp" />

                        <ImageView
                            android:id="@+id/iconEndTime"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="14dp"
                            android:contentDescription="End time"
                            android:src="@drawable/ic_eventdetails_clock"
                            app:tint="#B29F9F" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Register By -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    app:cardBackgroundColor="@color/color_surface_white"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etRegisterBy"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/inter"
                            android:gravity="center_vertical"
                            android:hint="Register By"
                            android:paddingStart="16dp"
                            android:paddingEnd="8dp"
                            android:singleLine="true"
                            android:textColor="@color/color_icon_outline"
                            android:textColorHint="@color/color_text_tertiary"
                            android:textSize="16sp" />

                        <ImageView
                            android:id="@+id/iconRegisterBy"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="14dp"
                            android:contentDescription="Register by"
                            android:src="@drawable/ic_eventdetails_calendar"
                            app:tint="#B29F9F" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Venue -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    app:cardBackgroundColor="@color/color_surface_white"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etVenue"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/inter"
                            android:gravity="center_vertical"
                            android:hint="Venue"
                            android:paddingStart="16dp"
                            android:paddingEnd="8dp"
                            android:singleLine="true"
                            android:textColor="@color/color_icon_outline"
                            android:textColorHint="@color/color_text_tertiary"
                            android:textSize="16sp" />

                        <ImageView
                            android:id="@+id/iconVenue"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="14dp"
                            android:contentDescription="Venue"
                            android:src="@drawable/ic_eventdetails_location"
                            app:tint="#B29F9F" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Open to -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="@color/color_surface_white"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="40dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/etOpenTo"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/inter"
                            android:gravity="center_vertical"
                            android:hint="Open to"
                            android:paddingStart="16dp"
                            android:paddingEnd="8dp"
                            android:singleLine="true"
                            android:textColor="@color/color_icon_outline"
                            android:textColorHint="@color/color_text_tertiary"
                            android:textSize="16sp" />

                        <ImageView
                            android:id="@+id/iconOpenTo"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="14dp"
                            android:contentDescription="Open to dropdown"
                            android:src="@drawable/ic_addevent_dropdown"
                            app:tint="#B29F9F" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </ScrollView>

        <!-- Buttons row -->
        <LinearLayout
            android:id="@+id/actionButtonsRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="50dp"
            android:paddingEnd="50dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            app:layout_constraintBottom_toTopOf="@id/navBarView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnCancelCard"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/color_icon_outline"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/tvCancel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/inter_variable"
                    android:gravity="center"
                    android:text="Cancel"
                    android:textColor="@color/color_icon_outline"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnSubmitCard"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                app:cardBackgroundColor="@color/color_primary_dark"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/tvSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/inter_variable"
                    android:gravity="center"
                    android:text="Submit"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Bottom navbar -->
        <include
            android:id="@+id/navBarView"
            layout="@layout/component_navbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
