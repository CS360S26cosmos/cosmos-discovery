<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_primary">

        <!-- Top bar (back + title + menu) -->
        <LinearLayout
            android:id="@+id/layoutTopBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/color_primary"
            android:paddingTop="12dp"
            android:paddingBottom="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <include
                android:id="@+id/topBarView"
                layout="@layout/view_top_bar_organiser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Content card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/contentCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardBackgroundColor="@color/color_surface"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:shapeAppearance="@style/ShapeAppearance.ContentCard"
            app:layout_constraintTop_toBottomOf="@id/layoutTopBar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:clipToPadding="false"
                    android:paddingBottom="140dp"
                    android:scrollbars="vertical"
                    android:scrollbarStyle="outsideOverlay">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="24dp">

                        <!-- ── PENDING SECTION ─────────────────────── -->

                        <LinearLayout
                            android:id="@+id/sectionPending"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Section header -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingStart="20dp"
                                android:paddingEnd="20dp"
                                android:layout_marginBottom="14dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_schedule"
                                    app:tint="@color/color_text_secondary"
                                    android:contentDescription="Pending" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="Pending"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/color_text_secondary"
                                    android:fontFamily="@font/inter_variable"
                                    android:includeFontPadding="false" />

                                <TextView
                                    android:id="@+id/badgePendingCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/bg_btn_rsvp"
                                    android:paddingStart="9dp"
                                    android:paddingEnd="9dp"
                                    android:paddingTop="2dp"
                                    android:paddingBottom="2dp"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/color_text_on_primary"
                                    android:fontFamily="@font/inter_variable"
                                    android:includeFontPadding="false"
                                    tools:text="2" />

                            </LinearLayout>

                            <!-- Empty state -->
                            <TextView
                                android:id="@+id/tvEmptyPending"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="20dp"
                                android:layout_marginEnd="20dp"
                                android:layout_marginBottom="16dp"
                                android:fontFamily="@font/inter_variable"
                                android:text="No pending events"
                                android:textColor="@color/color_text_tertiary"
                                android:textSize="14sp"
                                android:visibility="gone" />

                            <!-- Horizontal carousel -->
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvPendingEvents"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clipToPadding="false"
                                android:clipChildren="false"
                                android:overScrollMode="never"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:layout_marginBottom="8dp"
                                android:orientation="horizontal"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                tools:listitem="@layout/item_event_card_organizer" />

                        </LinearLayout>

                        <!-- ── APPROVED SECTION ────────────────────── -->

                        <LinearLayout
                            android:id="@+id/sectionApproved"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Section header -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingStart="20dp"
                                android:paddingEnd="20dp"
                                android:layout_marginBottom="14dp">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_check_circle"
                                    app:tint="@color/color_text_secondary"
                                    android:contentDescription="Approved" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="Approved"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/color_text_secondary"
                                    android:fontFamily="@font/inter_variable"
                                    android:includeFontPadding="false" />

                                <TextView
                                    android:id="@+id/badgeApprovedCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/bg_btn_rsvp"
                                    android:paddingStart="9dp"
                                    android:paddingEnd="9dp"
                                    android:paddingTop="2dp"
                                    android:paddingBottom="2dp"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/color_text_on_primary"
                                    android:fontFamily="@font/inter_variable"
                                    android:includeFontPadding="false"
                                    tools:text="2" />

                            </LinearLayout>

                            <!-- Empty state -->
                            <TextView
                                android:id="@+id/tvEmptyApproved"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="20dp"
                                android:layout_marginEnd="20dp"
                                android:layout_marginBottom="16dp"
                                android:fontFamily="@font/inter_variable"
                                android:text="No approved events yet"
                                android:textColor="@color/color_text_tertiary"
                                android:textSize="14sp"
                                android:visibility="gone" />

                            <!-- Horizontal carousel -->
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvApprovedEvents"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clipToPadding="false"
                                android:clipChildren="false"
                                android:overScrollMode="never"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:layout_marginBottom="8dp"
                                android:orientation="horizontal"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                tools:listitem="@layout/item_event_card_organizer" />

                        </LinearLayout>

                        <!-- ── REJECTED SECTION (collapsible) ──────── -->

                        <LinearLayout
                            android:id="@+id/sectionRejected"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Tappable header -->
                            <LinearLayout
                                android:id="@+id/rejectedHeader"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:paddingStart="20dp"
                                android:paddingEnd="20dp"
                                android:paddingTop="10dp"
                                android:paddingBottom="10dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackgroundBorderless">

                                <ImageView
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:src="@drawable/ic_cancel"
                                    app:tint="@color/color_text_secondary"
                                    android:contentDescription="Rejected" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="Rejected"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/color_text_secondary"
                                    android:fontFamily="@font/inter_variable"
                                    android:includeFontPadding="false" />

                                <TextView
                                    android:id="@+id/badgeRejectedCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/bg_btn_rsvp"
                                    android:paddingStart="9dp"
                                    android:paddingEnd="9dp"
                                    android:paddingTop="2dp"
                                    android:paddingBottom="2dp"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/color_text_on_primary"
                                    android:fontFamily="@font/inter_variable"
                                    android:includeFontPadding="false"
                                    tools:text="0" />

                                <ImageView
                                    android:id="@+id/iconRejectedChevron"
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_marginStart="8dp"
                                    android:src="@drawable/ic_expand_more"
                                    app:tint="#888888"
                                    android:contentDescription="Expand" />

                            </LinearLayout>

                            <!-- Collapsible content -->
                            <LinearLayout
                                android:id="@+id/rejectedContent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp">

                                <TextView
                                    android:id="@+id/tvEmptyRejected"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="12dp"
                                    android:fontFamily="@font/inter_variable"
                                    android:text="No rejected events"
                                    android:textColor="@color/color_text_tertiary"
                                    android:textSize="14sp"
                                    android:visibility="gone" />

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/rvRejectedEvents"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:nestedScrollingEnabled="false"
                                    android:clipToPadding="false"
                                    android:paddingBottom="12dp"
                                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                    tools:listitem="@layout/item_event_card_organizer" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Empty state for entire page -->
                        <TextView
                            android:id="@+id/tvEmptyPostedEvents"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="20dp"
                            android:layout_marginTop="32dp"
                            android:gravity="center"
                            android:fontFamily="@font/inter_variable"
                            android:text="You haven't posted any events yet."
                            android:textColor="@color/color_text_tertiary"
                            android:textSize="14sp"
                            android:visibility="gone" />

                    </LinearLayout>

                </androidx.core.widget.NestedScrollView>

                <!-- FAB — Create New Event -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/fabCreateEvent"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="100dp"
                    app:cardBackgroundColor="@color/color_primary_dark"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="4dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_add"
                        app:tint="@android:color/white"
                        android:contentDescription="Create Event" />

                </com.google.android.material.card.MaterialCardView>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Bottom nav -->
        <include
            android:id="@+id/navBarView"
            layout="@layout/component_navbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Sidebar -->
    <include
        android:id="@+id/sidebarView"
        layout="@layout/component_sidebar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
