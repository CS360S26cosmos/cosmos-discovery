<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_surface"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Sub-tab chips: Pending Requests / All Users -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/chipPendingRequests"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_selected"
                android:fontFamily="@font/inter_variable"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Pending Requests"
                android:textColor="@color/white"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/chipAllUsers"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_chip_unselected"
                android:fontFamily="@font/inter_variable"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="All Users"
                android:textColor="@color/color_text_secondary"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- PENDING REQUESTS panel -->
        <FrameLayout
            android:id="@+id/panelPendingRequests"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="visible">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPendingRequests"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="90dp"
                android:scrollbars="vertical"
                android:scrollbarStyle="outsideOverlay" />

            <TextView
                android:id="@+id/tvEmptyRequests"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="No pending requests"
                android:textColor="@color/color_text_hint"
                android:textSize="15sp"
                android:visibility="gone" />

        </FrameLayout>

        <!-- ALL USERS panel -->
        <LinearLayout
            android:id="@+id/panelAllUsers"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Search bar matching student screen design -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/color_card_bg"
                app:cardCornerRadius="28dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/search"
                        android:src="@drawable/ic_search_icon"
                        app:tint="@color/color_icon_outline" />

                    <EditText
                        android:id="@+id/etSearchUsers"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@null"
                        android:fontFamily="@font/inter_variable"
                        android:hint="Search Users"
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/color_text_secondary"
                        android:textColorHint="@color/color_text_hint"
                        android:textSize="14sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAllUsers"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="16dp"
                    android:scrollbars="vertical"
                    android:scrollbarStyle="outsideOverlay" />

                <TextView
                    android:id="@+id/tvEmptyUsers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="No users found"
                    android:textColor="@color/color_text_hint"
                    android:textSize="15sp"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Role Change Overlay -->
    <FrameLayout
        android:id="@+id/overlayRoleChange"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/roleChangeCard"
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:cardBackgroundColor="@color/color_surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="20dp">

                <!-- Header -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="@font/inter_variable"
                        android:text="Change Role"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/btnCloseRoleChange"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="21dp"
                        android:src="@drawable/ic_sidebar_close_btn" />

                </FrameLayout>

                <!-- User name -->
                <TextView
                    android:id="@+id/tvRoleChangeUserName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/inter_variable"
                    android:gravity="center"
                    android:textColor="@color/color_text_hint"
                    android:textSize="14sp" />

                <!-- Role chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipRoleStudent"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:fontFamily="@font/inter_variable"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Student"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipRoleOrganizer"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:fontFamily="@font/inter_variable"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Organizer"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chipRoleAdmin"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:fontFamily="@font/inter_variable"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Admin"
                        android:textColor="@color/color_text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

                <!-- Action buttons -->
                <LinearLayout
                    android:layout_width="290dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_filter_button_container"
                    android:orientation="horizontal"
                    android:padding="1dp">

                    <TextView
                        android:id="@+id/btnCancelRoleChange"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_clear_filters"
                        android:fontFamily="@font/inter_variable"
                        android:gravity="center"
                        android:text="Cancel"
                        android:textColor="@color/color_icon_outline"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/color_text_secondary" />

                    <TextView
                        android:id="@+id/btnConfirmRoleChange"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_view_results_selector"
                        android:fontFamily="@font/inter_variable"
                        android:gravity="center"
                        android:text="Confirm"
                        android:textColor="@color/color_text_on_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</FrameLayout>
