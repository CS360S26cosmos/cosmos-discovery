<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- dark overlay -->
    <View
        android:id="@+id/sidebarOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000" />

    <!-- sidebar -->
    <LinearLayout
        android:id="@+id/sidebarPanel"
        android:layout_width="220dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@color/color_surface_white">

        <!-- tOP PURPLE SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/color_surface"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">


            <!-- close button -->

            <!-- profile section -->
            <ImageView
                android:id="@+id/btnCloseSidebar"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="end"
                android:layout_marginTop="0dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="Close sidebar"
                android:src="@drawable/ic_sidebar_close_btn" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/sidebarProfileIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_sidebar_main_profileimage"
                    android:contentDescription="Profile" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/sidebarUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Steve Jobs"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_secondary"
                        android:fontFamily="@font/inter_variable"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/sidebarUserEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="stevejobs@apple.com"
                        android:textSize="10sp"
                        android:textColor="#4F4A50"
                        android:fontFamily="@font/inter_variable"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- divider below purple section -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDD6DD" />

        <!-- settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_sidebar_settings_icon"
                android:contentDescription="Settings" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="Settings"
                android:textSize="17sp"
                android:textColor="@color/color_text_secondary"
                android:fontFamily="@font/inter_variable" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_sidebar_arrow_icon"
                android:contentDescription="Go to settings" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="#DDD6DD" />

        <!-- profile -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_sidebar_profile_icon"
                android:contentDescription="View profile" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="View Profile"
                android:textSize="17sp"
                android:textColor="@color/color_text_secondary"
                android:fontFamily="@font/inter_variable" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_sidebar_arrow_icon"
                android:contentDescription="Go to profile" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- bottom divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="#DDD6DD" />

        <!-- logout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_sidebar_logout"
                android:contentDescription="Log out" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="Log Out"
                android:textSize="17sp"
                android:textColor="@color/color_text_secondary"
                android:fontFamily="@font/inter_variable" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_sidebar_arrow_icon"
                android:contentDescription="Log out" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>