<?xml version="1.0" encoding="utf-8"?>
<!--
    Figma spec (big / "Discover" card):
      card:      full-width, cornerRadius 17dp, fill #FFFCFE
      image:     full width × 155dp, flush to card top edge — card clips corners
      scrim:     transparent → #B3000000 gradient over image
      title:     22sp bold white, anchored 16dp above image bottom
      dateTime:  13sp white, 4dp below title
      ─── white section ────────────────────────────────
      location:  pin icon (12dp) + text 14sp, 12dp from image bottom
      chips:     10sp outline chips, 8dp below location
      RSVP count: group icon (14dp) + "N RSVPs" 10sp, inline with chips
      RSVP btn:  pill (bg_btn_rsvp), 14sp bold white, right-aligned,
                 vertically spanning both rows
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="17dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="@color/color_card_event"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Full-width event image at the top of the card -->
        <ImageView
            android:id="@+id/imageViewEvent"
            android:layout_width="0dp"
            android:layout_height="155dp"
            android:scaleType="centerCrop"
            android:src="@color/color_text_hint"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Gradient scrim — makes white title/date readable over any image -->
        <View
            android:id="@+id/viewImageScrim"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_image_gradient"
            app:layout_constraintTop_toTopOf="@id/imageViewEvent"
            app:layout_constraintBottom_toBottomOf="@id/imageViewEvent"
            app:layout_constraintStart_toStartOf="@id/imageViewEvent"
            app:layout_constraintEnd_toEndOf="@id/imageViewEvent" />

        <!-- Event title — bold white, anchored near image bottom -->
        <TextView
            android:id="@+id/textViewTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Musical Night"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/color_surface_white"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/textViewDateTime" />

        <!-- Date & time — white, sits 12dp above image bottom edge -->
        <TextView
            android:id="@+id/textViewDateTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="18th March 2026 | 7:00pm"
            android:textSize="13sp"
            android:textColor="@color/color_surface_white"
            android:includeFontPadding="false"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/imageViewEvent" />

        <!-- ── White section below image ────────────────────────── -->

        <!-- Location pin icon -->
        <ImageView
            android:id="@+id/iconLocation"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_location_pin"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            app:tint="@color/color_text_secondary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageViewEvent"
            app:layout_constraintBottom_toBottomOf="@id/textViewLocation" />

        <!-- Location text -->
        <TextView
            android:id="@+id/textViewLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="REDC Lawn"
            android:textSize="14sp"
            android:textColor="@color/color_text_secondary"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:layout_marginStart="5dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/iconLocation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imageViewEvent" />

        <!-- RSVP button — pill shape, spans both bottom rows, h=35dp per spec -->
        <Button
            android:id="@+id/buttonRsvp"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:text="RSVP"
            android:textColor="@color/color_surface_white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_rsvp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginEnd="12dp"
            app:backgroundTint="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/layoutChipsRow"
            app:layout_constraintBottom_toBottomOf="@id/layoutChipsRow" />

        <!-- Not Interested — small dismiss action, sits below the image, left-aligned -->
        <TextView
            android:id="@+id/textViewNotInterested"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕  Not Interested"
            android:textSize="11sp"
            android:textColor="@color/color_text_hint"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutChipsRow" />

        <!-- Chips row: tags + attendee count all inline, bounded by RSVP button -->
        <LinearLayout
            android:id="@+id/layoutChipsRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="0dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textViewLocation"
            app:layout_constraintBottom_toTopOf="@id/textViewNotInterested"
            app:layout_constraintEnd_toStartOf="@id/buttonRsvp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupTags"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="6dp"
                app:singleLine="true" />

            <ImageView
                android:id="@+id/iconGroup"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_group"
                android:layout_marginStart="8dp"
                app:tint="@color/color_text_secondary" />

            <TextView
                android:id="@+id/textViewRsvpCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="220 RSVPs"
                android:textSize="10sp"
                android:textColor="@color/color_text_secondary"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:layout_marginStart="4dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
