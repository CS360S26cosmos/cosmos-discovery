<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_primary">

        <!-- TOP BAR -->
        <LinearLayout
            android:id="@+id/layoutTopBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <include
                layout="@layout/view_top_bar_organiser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- WHITE CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/contentCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="@color/color_surface"
            app:cardElevation="0dp"
            app:shapeAppearance="@style/ShapeAppearance.ContentCard"
            app:layout_constraintTop_toBottomOf="@id/layoutTopBar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- CONTENT INSIDE WHITE CARD -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:paddingBottom="80dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="190dp"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <!-- ROW: Metrics -->
                    <LinearLayout
                        android:id="@+id/top_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <!-- Capacity Column -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <LinearLayout
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_groups"
                                    android:layout_marginEnd="6dp"
                                    app:tint="@android:color/black"/>
                                <TextView
                                    android:text="Capacity:"
                                    android:textStyle="bold"
                                    android:textSize="16sp"
                                    android:textColor="@android:color/black"/>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/capacity_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="250 Students"
                                android:textSize="14sp"
                                android:textColor="@android:color/black"
                                android:layout_marginTop="2dp"/>

                            <Button
                                android:id="@+id/btnAnnouncement"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginTop="8dp"
                                android:text="Announcement"
                                android:textSize="12sp"
                                android:backgroundTint="#7B0F4F"
                                android:textColor="@android:color/white"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="18dp"/>
                        </LinearLayout>

                        <!-- RSVP Column -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center_horizontal">

                            <LinearLayout
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_groups"
                                    android:layout_marginEnd="6dp"
                                    app:tint="@android:color/black"/>
                                <TextView
                                    android:text="RSVPs"
                                    android:textStyle="bold"
                                    android:textSize="16sp"
                                    android:textColor="@android:color/black"/>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/rsvp_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="100 Students"
                                android:textSize="14sp"
                                android:textColor="@android:color/black"
                                android:layout_marginTop="2dp"/>

                            <Button
                                android:id="@+id/btnAttendeeList"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginTop="8dp"
                                android:text="Attendee List"
                                android:textSize="12sp"
                                android:backgroundTint="#7B0F4F"
                                android:textColor="@android:color/white"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:cornerRadius="18dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ANALYTICS TITLE -->
                    <TextView
                        android:id="@+id/analytics_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Analytics"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@android:color/black"
                        android:gravity="start"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="12dp"/>

                    <!-- ══════════════ CARD 1 — Views vs. RSVPs ══════════════ -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardViewsVsRsvps"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#EDD7EF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:paddingTop="12dp"
                            android:paddingBottom="8dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp">

                            <!-- Card title -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Views vs. RSVPs"
                                android:textColor="@color/color_primary_dark"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginBottom="4dp"/>

                            <!-- ScatterChart -->
                            <com.github.mikephil.charting.charts.ScatterChart
                                android:id="@+id/scatterChart"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- ══════════════ CARD 2 — RSVPs vs. Days Since Posted ══ -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardRsvpsVsDays"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#EDD7EF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:paddingTop="12dp"
                            android:paddingBottom="8dp"
                            android:paddingStart="10dp"
                            android:paddingEnd="8dp">

                            <!-- Card title -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RSVPs vs. Days Since Posted"
                                android:textColor="@color/color_primary_dark"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium"
                                android:layout_marginBottom="4dp"/>

                            <!-- LineChart -->
                            <com.github.mikephil.charting.charts.LineChart
                                android:id="@+id/lineChart"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </ScrollView>

        </com.google.android.material.card.MaterialCardView>

        <!-- EVENT CARD (FLOATING ON TOP) -->
        <include
            android:id="@+id/eventCard"
            layout="@layout/item_event_card_fixed"
            android:layout_width="356dp"
            android:layout_height="230dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="65dp"
            android:elevation="12dp"/>

        <!-- NAV BAR -->
        <include
            layout="@layout/component_navbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SIDEBAR -->
    <include
        layout="@layout/component_sidebar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>

</FrameLayout>