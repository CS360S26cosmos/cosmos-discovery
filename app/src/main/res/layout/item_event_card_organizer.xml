<?xml version="1.0" encoding="utf-8"?>
<!-- Organizer variant of item_event_card_small: replaces RSVP button with a status badge. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="112dp"
    android:layout_marginBottom="20dp"
    app:cardCornerRadius="17dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/color_card_event"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imageViewEvent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:src="@color/color_text_hint"
            app:shapeAppearance="@style/ShapeAppearance.EventImage"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/textViewTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="6dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Campus Comedy Jam"
            android:textColor="@color/color_text_secondary"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/imageViewEvent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/textViewDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:includeFontPadding="false"
            android:text="Saturday | 5:00pm"
            android:textColor="@color/color_text_secondary"
            android:textSize="11sp"
            app:layout_constraintStart_toEndOf="@id/imageViewEvent"
            app:layout_constraintTop_toBottomOf="@id/textViewTitle" />

        <ImageView
            android:id="@+id/iconLocation"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/ic_location_pin"
            app:tint="@color/color_text_secondary"
            app:layout_constraintStart_toEndOf="@id/imageViewEvent"
            app:layout_constraintTop_toBottomOf="@id/textViewDateTime"
            app:layout_constraintBottom_toBottomOf="@id/textViewLocation" />

        <TextView
            android:id="@+id/textViewLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="6dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="Sports Complex"
            android:textColor="@color/color_text_secondary"
            android:textSize="9sp"
            app:layout_constraintStart_toEndOf="@id/iconLocation"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textViewDateTime" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="10dp"
            app:chipSpacingHorizontal="4dp"
            app:singleLine="true"
            app:layout_constraintStart_toEndOf="@id/imageViewEvent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/iconGroup"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/ic_group"
            app:tint="@color/color_text_secondary"
            app:layout_constraintStart_toEndOf="@id/chipGroupTags"
            app:layout_constraintTop_toTopOf="@id/chipGroupTags"
            app:layout_constraintBottom_toBottomOf="@id/chipGroupTags" />

        <TextView
            android:id="@+id/textViewRsvpCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:includeFontPadding="false"
            android:text="190 RSVPs"
            android:textColor="@color/color_text_secondary"
            android:textSize="8sp"
            app:layout_constraintStart_toEndOf="@id/iconGroup"
            app:layout_constraintTop_toTopOf="@id/chipGroupTags"
            app:layout_constraintBottom_toBottomOf="@id/chipGroupTags" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
