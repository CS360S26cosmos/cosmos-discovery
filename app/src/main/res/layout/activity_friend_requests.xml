<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main screen chrome -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_primary">

        <!-- Purple header: top bar -->
        <LinearLayout
            android:id="@+id/layoutTopBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/color_primary"
            android:paddingTop="12dp"
            android:paddingBottom="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <include
                android:id="@+id/topBarView"
                layout="@layout/view_top_bar_organiser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Content card — rounded top corners, fills the rest of the screen -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/contentCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:shapeAppearance="@style/ShapeAppearance.ContentCard"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/color_surface"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/layoutTopBar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="32dp">

                    <!-- Incoming Requests header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Incoming Requests"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_secondary"
                            android:fontFamily="@font/inter_variable" />

                        <TextView
                            android:id="@+id/badgeIncomingCount"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:gravity="center"
                            android:text="0"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/color_text_on_primary"
                            android:fontFamily="@font/inter_variable"
                            android:background="@drawable/bg_count_badge" />

                    </LinearLayout>

                    <!-- Incoming empty state -->
                    <TextView
                        android:id="@+id/tvEmptyIncoming"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center"
                        android:text="No incoming requests"
                        android:textSize="14sp"
                        android:textColor="@color/color_text_hint"
                        android:fontFamily="@font/inter_variable"
                        android:visibility="gone" />

                    <!-- Incoming requests list -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvIncomingRequests"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                    <!-- Sent Requests header -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="12dp"
                        android:text="Sent Requests"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/color_text_secondary"
                        android:fontFamily="@font/inter_variable" />

                    <!-- Sent empty state -->
                    <TextView
                        android:id="@+id/tvEmptySent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="No sent requests"
                        android:textSize="14sp"
                        android:textColor="@color/color_text_hint"
                        android:fontFamily="@font/inter_variable"
                        android:visibility="gone" />

                    <!-- Sent requests list -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSentRequests"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Sidebar overlay (GONE until menu icon tapped) -->
    <include
        android:id="@+id/sidebarView"
        layout="@layout/component_sidebar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
