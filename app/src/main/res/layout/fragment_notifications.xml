<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:paddingBottom="90dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- Tab toggle — organizers only, hidden by default -->
        <LinearLayout
            android:id="@+id/toggleNotifType"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_toggle_container"
            android:padding="4dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnPersonal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Personal"
                android:gravity="center"
                android:textSize="14sp"
                android:fontFamily="@font/inter_variable"
                android:textStyle="bold"
                android:background="@drawable/bg_notif_tab_selected"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/btnOrganizer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Organizer"
                android:gravity="center"
                android:textSize="14sp"
                android:fontFamily="@font/inter_variable"
                android:textStyle="bold"
                android:background="@drawable/bg_notif_tab_unselected"
                android:textColor="@color/color_text_hint" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvClearAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="4dp"
            android:text="Clear all"
            android:textSize="13sp"
            android:textColor="@color/color_primary"
            android:fontFamily="@font/inter_variable"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone" />

        <!-- Personal notifications list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGeneralNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/tvEmptyGeneralNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="No notifications yet."
            android:textSize="14sp"
            android:textColor="@color/color_text_hint"
            android:fontFamily="@font/inter_variable"
            android:gravity="center"
            android:visibility="gone" />

        <!-- Organizer tab content (shown when Organizer tab selected) -->
        <TextView
            android:id="@+id/tvOrganizerComingSoon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Organizer notifications coming soon."
            android:textSize="14sp"
            android:textColor="@color/color_text_hint"
            android:fontFamily="@font/inter_variable"
            android:gravity="center"
            android:visibility="gone" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
